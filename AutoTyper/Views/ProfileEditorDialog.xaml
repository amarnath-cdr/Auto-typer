<Window x:Class="AutoTyper.Views.ProfileEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:AutoTyper.Models"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="780" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <ObjectDataProvider x:Key="TypingModeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:TypingMode"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="CapitalizationValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:CapitalizationMode"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="Configure trigger shortcuts, content, special keys, and execution timing."
                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Scrollable Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
            <StackPanel>
                <!-- Name & Shortcut Row -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Profile Name *" Style="{StaticResource FormLabelStyle}" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Shortcut *" Style="{StaticResource FormLabelStyle}" />
                        <ComboBox ItemsSource="{Binding AvailableShortcuts}"
                                  SelectedItem="{Binding Shortcut}"
                                  IsEditable="True"
                                  Padding="8,7"
                                  FontSize="13" />
                    </StackPanel>
                </Grid>

                <!-- Text Content -->
                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="Text to Type *" Style="{StaticResource FormLabelStyle}" />
                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBoxStyle}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="100"
                             VerticalScrollBarVisibility="Auto" />
                </StackPanel>

                <!-- Special Key Syntax Guide -->
                <Border Style="{StaticResource CardStyle}" Padding="10,8" Margin="0,0,0,12" Background="{DynamicResource ControlBackgroundBrush}">
                    <StackPanel>
                        <TextBlock Text="Special Keys &amp; Shortcuts Cheat Sheet" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="Keys: {ENTER} {TAB} {BACKSPACE} {ESC} {UP} {DOWN} {LEFT} {RIGHT} {F1}-{F12}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="Combos: {CTRL+C} {CTRL+V} {ALT+TAB} {WIN+D} {CTRL+SHIFT+S}  |  Literal: {{ and }}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        <TextBlock Text="Wait (Simulated Mode Only): {WAIT:500} = pause 500ms" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <!-- Comment / Description -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Comment / Description (Optional)" Style="{StaticResource FormLabelStyle}" />
                    <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" />
                </StackPanel>

                <!-- Timing & Mode Row -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Typing Mode" Style="{StaticResource FormLabelStyle}" />
                        <ComboBox ItemsSource="{Binding Source={StaticResource TypingModeValues}}"
                                  SelectedItem="{Binding TypingMode}"
                                  Padding="8,7"
                                  FontSize="13" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Start Delay (ms)" Style="{StaticResource FormLabelStyle}" />
                        <TextBox Text="{Binding StartDelayMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Typing Delay (ms)" Style="{StaticResource FormLabelStyle}" />
                        <TextBox Text="{Binding TypingDelayMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" />
                    </StackPanel>
                </Grid>

                <!-- Random Jitter Option -->
                <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox Content="Enable Random Jitter / Variable Delay"
                                  IsChecked="{Binding UseJitter}"
                                  FontSize="13"
                                  FontWeight="SemiBold"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Margin="0,0,0,8" />

                        <Grid Visibility="{Binding UseJitter, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Min Delay (ms)" Style="{StaticResource FormLabelStyle}" />
                                <TextBox Text="{Binding MinDelayMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Max Delay (ms)" Style="{StaticResource FormLabelStyle}" />
                                <TextBox Text="{Binding MaxDelayMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Capitalization & Repeat Row -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Capitalization" Style="{StaticResource FormLabelStyle}" />
                        <ComboBox ItemsSource="{Binding Source={StaticResource CapitalizationValues}}"
                                  SelectedItem="{Binding Capitalization}"
                                  Padding="8,7"
                                  FontSize="13" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Repeat Count" Style="{StaticResource FormLabelStyle}" />
                        <TextBox Text="{Binding RepeatCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" />
                    </StackPanel>
                </Grid>

                <!-- Enable Profile Switch -->
                <CheckBox Content="Enable this profile"
                          IsChecked="{Binding IsEnabled}"
                          FontSize="13"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          Margin="0,4,0,8" />

                <!-- Validation Error Notice -->
                <Border Background="{DynamicResource DangerBrush}"
                        CornerRadius="6"
                        Padding="10"
                        Margin="0,8,0,0"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerForegroundBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlBorderBrush}" Padding="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,12,0" IsCancel="True" />
                <Button Content="Save Profile" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
